FROM node:22-bookworm-slim

WORKDIR /workspace

COPY scripts ./scripts
COPY skills_keyan ./skills_keyan
COPY openclaw ./openclaw

RUN corepack enable \
  && cd /workspace/openclaw \
  && pnpm install --frozen-lockfile \
  && pnpm build:docker

ENV RUNS_DIR=/data/runs
ENV SKILLS_DIR=/workspace/skills_keyan
ENV OPENCLAW_CLI=/workspace/openclaw/openclaw.mjs
ENV OPENCLAW_NODE=/usr/local/bin/node
ENV OPENCLAW_SKILLS_DIR=/workspace/skills_keyan

USER node

ENTRYPOINT ["node", "/workspace/scripts/openclaw-skill-pipeline.js"]
